# halloween-eyes.service — systemd USER unit that keeps the show running.
#
# Installed to ~/.config/systemd/user/ by deploy/install-autostart.sh.
# Deliberately NOT enabled at boot: cron (deploy/crontab.example) starts and
# stops it, so a 3am reboot leaves the windows dark.
# After a reboot inside show hours, cron's @reboot line restarts it
# (deploy/start-if-show-hours.sh).
#   Start now:  systemctl --user start halloween-eyes
#   Stop now:   systemctl --user stop halloween-eyes
#   Logs:       journalctl --user -u halloween-eyes -f
[Unit]
Description=Halloween eye windows
# The pages come from the all-day show server; starting the show starts it too.
Wants=eyes-server.service
After=eyes-server.service
# Never give up retrying. While the desktop is restarting (monitor power
# cycle, relogin) the launch fails every few seconds until it is back.
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=APP_DIR=%h/halloween-eyes
# Wake the monitors if eyes-idle.service put them to sleep. The leading "-"
# means a failure here never stops the show from starting.
ExecStartPre=-%h/halloween-eyes/deploy/screens.sh on
ExecStart=%h/halloween-eyes/deploy/launch-windows.sh
# Sleep the monitors after a deliberate stop (cron at 23:30, or by hand), but
# not between crash restarts: systemd sets SERVICE_RESULT=success only for a
# clean stop. Needed because swayidle's timeout already fired during the show
# and will not fire again until someone touches the keyboard or mouse.
ExecStopPost=-/bin/sh -c '[ "$$SERVICE_RESULT" = success ] && %h/halloween-eyes/deploy/screens.sh off --force'
Restart=always
RestartSec=5
