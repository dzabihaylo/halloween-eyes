# eyes-server.service — systemd USER unit: the show server, running all day.
#
# Installed and enabled by deploy/install-autostart.sh. Linger starts it at boot
# with no one logged in, so the phone control page (and its Power off button)
# answers outside show hours too. The show windows load from it; if it restarts
# mid-show, they keep running on their last config.
#   Logs:  journalctl --user-unit eyes-server -f
[Unit]
Description=Halloween eyes show server and phone control page
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/halloween-eyes
ExecStart=/usr/bin/python3 server/serve.py --root public --config server/config.json --port 8080
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
